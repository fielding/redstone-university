---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Sidebar from '../../components/Sidebar.astro';

export async function getStaticPaths() {
  const courseEntries = await getCollection('course');
  return courseEntries.map(entry => ({
    params: { slug: entry.slug }, props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();
const pageTitle = entry.data.title || 'Redstone University';

// Surface h2/h3 as in-page navigation — these are Lessons and subsections
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<Layout title={pageTitle} math>
  <div class="reading-progress" aria-hidden="true"></div>
  <div class="course-layout">
    <aside class="sidebar">
      <div class="sidebar-header">
        <a href="/" class="logo-link" aria-label="Redstone University — home">
          <img
            src="/assets/project_assets/logo.png"
            alt=""
            class="sidebar-logo"
            width="192"
            height="192"
          />
        </a>
      </div>
      <Sidebar currentSlug={entry.slug} />
    </aside>

    <main class="main">
      <article class="prose fade-in">
        <Content />
      </article>
    </main>

    {toc.length > 1 && (
      <aside class="toc" aria-label="On this page">
        <p class="toc-label">On this page</p>
        <ol class="toc-list">
          {toc.map((h) => (
            <li class:list={['toc-item', `toc-depth-${h.depth}`]}>
              <a href={`#${h.slug}`} class="toc-link" data-toc-target={h.slug}>
                {h.text}
              </a>
            </li>
          ))}
        </ol>
      </aside>
    )}
  </div>
</Layout>

<style>
  /* ── Reading Progress ── */
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 2px;
    background: var(--color-primary);
    width: 0%;
    z-index: 100;
    transform-origin: left;
    will-change: width;
  }

  /* ── Article fade-in ── */
  .fade-in {
    animation: content-enter 600ms var(--ease-out) both;
  }

  @keyframes content-enter {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* ── Layout ── */
  .course-layout {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr) 220px;
    gap: var(--space-xl);
    min-height: 100vh;
    max-width: 1540px;
    margin: 0 auto;
  }

  /* When TOC is absent, drop to two columns */
  .course-layout:not(:has(.toc)) {
    grid-template-columns: 280px minmax(0, 1fr);
  }

  /* ── Sidebar ── */
  .sidebar {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    flex-direction: column;
    padding: var(--space-lg) var(--space-lg) var(--space-lg) var(--space-xl);
    border-right: 1px solid var(--color-border-subtle);
    overflow: hidden;
  }

  .sidebar-header {
    padding-top: var(--space-md);
    padding-bottom: var(--space-xl);
    margin-bottom: var(--space-lg);
    border-bottom: 1px solid var(--color-border-subtle);
    flex-shrink: 0;
  }

  .logo-link {
    display: block;
    text-align: center;
  }

  .sidebar-logo {
    width: 192px;
    height: auto;
    margin: 0 auto;
    filter: drop-shadow(0 0 20px oklch(58% 0.13 65 / 0.30));
    transition: filter 500ms var(--ease-out-quart);
  }

  .logo-link:hover .sidebar-logo {
    filter: drop-shadow(0 0 28px oklch(58% 0.16 65 / 0.45));
  }

  /* ── Main Content ── */
  .main {
    display: flex;
    justify-content: center;
    padding: var(--space-3xl) var(--space-2xl) var(--space-4xl);
    min-width: 0;
  }

  /* ── In-page TOC (right rail) ── */
  .toc {
    position: sticky;
    top: var(--space-xl);
    align-self: start;
    max-height: calc(100vh - var(--space-2xl));
    padding: var(--space-3xl) var(--space-lg) var(--space-lg) 0;
    overflow-y: auto;
  }

  .toc-label {
    font-family: var(--font-reading);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-md);
  }

  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--color-border-subtle);
  }

  .toc-item {
    margin: 0;
  }

  .toc-link {
    display: block;
    font-family: var(--font-reading);
    font-size: 0.82rem;
    line-height: 1.4;
    color: var(--color-text-faint);
    text-decoration: none;
    padding: var(--space-xs) 0 var(--space-xs) var(--space-md);
    margin-left: -1px;
    border-left: 1px solid transparent;
    transition: color 150ms var(--ease-out), border-color 150ms var(--ease-out);
  }

  .toc-link:hover {
    color: var(--color-text);
  }

  .toc-link.is-active {
    color: var(--color-primary-light);
    border-left-color: var(--color-primary);
  }

  .toc-depth-3 .toc-link {
    padding-left: var(--space-lg);
    font-size: 0.78rem;
  }

  .toc::-webkit-scrollbar {
    width: 4px;
  }
  .toc::-webkit-scrollbar-track {
    background: transparent;
  }
  .toc::-webkit-scrollbar-thumb {
    background: var(--color-border);
    border-radius: 2px;
  }

  .prose {
    width: 100%;
    max-width: 66ch;
    font-family: var(--font-reading);
    font-weight: 400;
    color: var(--color-text);
    font-size: 1.0625rem; /* 17px base — sans reads smaller than serif */
    line-height: 1.7;
    letter-spacing: 0.005em;
  }

  /* ══════════════════════════════════════════════
     PROSE — every markdown element, unmistakable
     ══════════════════════════════════════════════ */

  /* ── Headings (stay serif for contrast with sans body) ── */
  .prose :global(h1) {
    font-family: var(--font-display);
    font-size: 2.5rem;
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--color-text);
    margin-bottom: var(--space-2xl);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--color-border);
  }

  .prose :global(h2) {
    font-family: var(--font-display);
    font-size: 1.875rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--color-text);
    margin-top: var(--space-4xl);
    margin-bottom: var(--space-lg);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--color-border-subtle);
  }

  .prose :global(h2:first-child),
  .prose :global(h1 + h2) {
    border-top: none;
    padding-top: 0;
    margin-top: 0;
  }

  .prose :global(h3) {
    font-family: var(--font-display);
    font-size: 1.375rem;
    line-height: 1.25;
    color: var(--color-text);
    margin-top: var(--space-3xl);
    margin-bottom: var(--space-md);
  }

  /* h4 as small-caps section label — common in book design */
  .prose :global(h4) {
    font-family: var(--font-reading);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-primary-light);
    margin-top: var(--space-2xl);
    margin-bottom: var(--space-md);
  }

  /* ── Body text ── */
  .prose :global(p) {
    margin-bottom: var(--space-lg);
  }

  /* ── Strong & emphasis ── */
  .prose :global(strong) {
    color: var(--color-text);
    font-weight: 600;
  }

  .prose :global(em) {
    color: var(--color-text);
    font-style: italic;
  }

  /* ── Links ── */
  .prose :global(a) {
    color: var(--color-primary-light);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--color-primary-dim);
    transition:
      color 150ms var(--ease-out),
      text-decoration-color 150ms var(--ease-out);
  }

  .prose :global(a:hover) {
    color: var(--color-accent);
    text-decoration-color: var(--color-accent);
  }

  /* ── Lists ── */
  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: var(--space-lg);
    padding-left: var(--space-xl);
  }

  .prose :global(li) {
    margin-bottom: var(--space-sm);
    line-height: 1.7;
  }

  .prose :global(li > ul),
  .prose :global(li > ol) {
    margin-top: var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .prose :global(li::marker) {
    color: var(--color-text-faint);
  }

  /* ── Blockquotes ── */
  .prose :global(blockquote) {
    position: relative;
    margin: var(--space-2xl) 0;
    padding: var(--space-xl) var(--space-xl) var(--space-xl) var(--space-2xl);
    background: var(--color-panel);
    border-radius: 0 6px 6px 0;
    border: 1px solid var(--color-border-subtle);
    border-left: none;
  }

  /* Warm accent line on left — thin, intentional, not a fat stripe */
  .prose :global(blockquote::before) {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--color-primary);
    border-radius: 2px 0 0 2px;
  }

  .prose :global(blockquote p) {
    margin-bottom: 0;
    color: var(--color-text-secondary);
    font-style: italic;
    line-height: 1.7;
  }

  .prose :global(blockquote p + p) {
    margin-top: var(--space-md);
  }

  .prose :global(blockquote strong) {
    color: var(--color-text);
    font-style: normal;
    font-weight: 700;
  }

  /* ── Horizontal rules ── */
  .prose :global(hr) {
    border: none;
    margin: var(--space-3xl) 0;
    height: 1px;
    background: var(--color-border-subtle);
  }

  /* ── Images ── */
  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 6px;
    margin: var(--space-2xl) auto;
    display: block;
    border: 1px solid var(--color-border-subtle);
  }

  /* ── Inline code ── */
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.84em;
    color: var(--color-code-text);
    font-weight: 500;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  /* ── Code blocks ── */
  .prose :global(pre) {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.7;
    background: var(--color-code-bg) !important;
    padding: var(--space-xl);
    border-radius: 6px;
    border: 1px solid var(--color-border);
    margin: var(--space-2xl) 0;
    overflow-x: auto;
  }

  .prose :global(pre code) {
    background: none;
    padding: 0;
    border: none;
    border-radius: 0;
    font-size: inherit;
    color: var(--color-text);
    font-weight: 400;
  }

  /* ── Tables ── */
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-2xl) 0;
    font-variant-numeric: tabular-nums;
    font-size: 0.92rem;
    border: 1px solid var(--color-border-subtle);
    border-radius: 6px;
    display: block;
    overflow-x: auto;
  }

  .prose :global(thead) {
    background: var(--color-panel);
  }

  .prose :global(th) {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-secondary);
    padding: var(--space-md) var(--space-md);
    border-bottom: 1px solid var(--color-border);
    text-align: left;
  }

  .prose :global(td) {
    padding: var(--space-sm) var(--space-md);
    border-bottom: 1px solid var(--color-border-subtle);
    color: var(--color-text);
  }

  .prose :global(tr:last-child td) {
    border-bottom: none;
  }

  .prose :global(tbody tr:hover) {
    background: var(--color-panel);
  }

  /* ── KaTeX math ── */
  .prose :global(.katex-display) {
    margin: var(--space-2xl) 0;
    padding: var(--space-lg) var(--space-xl);
    background: var(--color-panel);
    border-radius: 6px;
    overflow-x: auto;
  }

  .prose :global(.katex) {
    font-size: 1.1em;
    color: var(--color-text);
  }

  /* Inline math — slightly warmer than body text */
  .prose :global(.katex-inline .katex),
  .prose :global(span.katex) {
    font-size: 1.05em;
    color: var(--color-text-secondary);
  }

  /* ── Heading anchor links ── */
  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4) {
    position: relative;
  }

  .prose :global(.heading-anchor) {
    position: absolute;
    left: -1.5em;
    top: 0;
    color: var(--color-text-faint);
    text-decoration: none;
    font-weight: 400;
    opacity: 0;
    transition: opacity 200ms var(--ease-out);
    font-size: 0.85em;
  }

  .prose :global(h2:hover .heading-anchor),
  .prose :global(h3:hover .heading-anchor),
  .prose :global(h4:hover .heading-anchor) {
    opacity: 1;
  }

  .prose :global(.heading-anchor:hover) {
    color: var(--color-primary-light);
  }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .fade-in {
      animation: none;
    }
    .reading-progress {
      transition: none;
    }
  }

  /* ── Responsive ── */
  /* Below ~1200px, hide the on-page TOC */
  @media (max-width: 1200px) {
    .course-layout,
    .course-layout:not(:has(.toc)) {
      grid-template-columns: 280px minmax(0, 1fr);
    }

    .toc {
      display: none;
    }
  }

  /* Below 900px, collapse to single column */
  @media (max-width: 900px) {
    .course-layout,
    .course-layout:not(:has(.toc)) {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .sidebar {
      position: relative;
      height: auto;
      max-height: 50vh;
      border-right: none;
      border-bottom: 1px solid var(--color-border-subtle);
      padding: var(--space-md) var(--space-lg);
    }

    .main {
      padding: var(--space-xl) var(--space-lg) var(--space-3xl);
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // Reading progress bar — throttled with rAF
    const bar = document.querySelector('.reading-progress');
    if (bar) {
      let ticking = false;
      const update = () => {
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        if (docHeight > 0) {
          bar.style.width = (window.scrollY / docHeight) * 100 + '%';
        }
        ticking = false;
      };
      window.addEventListener('scroll', () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      }, { passive: true });
      update();
    }

    // Heading anchor links
    document.querySelectorAll('.prose h2, .prose h3, .prose h4').forEach((heading) => {
      if (!heading.id) {
        heading.id = heading.textContent
          .trim()
          .toLowerCase()
          .replace(/[^\w\s-]/g, '')
          .replace(/\s+/g, '-');
      }
      const anchor = document.createElement('a');
      anchor.href = '#' + heading.id;
      anchor.className = 'heading-anchor';
      anchor.textContent = '#';
      anchor.setAttribute('aria-label', 'Link to this section');
      heading.prepend(anchor);
    });

    // TOC active-section highlighting
    const tocLinks = document.querySelectorAll('.toc-link');
    if (tocLinks.length > 0) {
      const linkMap = new Map();
      tocLinks.forEach((link) => {
        const id = link.dataset.tocTarget;
        if (id) linkMap.set(id, link);
      });

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const link = linkMap.get(entry.target.id);
            if (!link) return;
            if (entry.isIntersecting) {
              tocLinks.forEach((l) => l.classList.remove('is-active'));
              link.classList.add('is-active');
            }
          });
        },
        { rootMargin: '-20% 0px -70% 0px' }
      );

      linkMap.forEach((_, id) => {
        const target = document.getElementById(id);
        if (target) observer.observe(target);
      });
    }
  });
</script>
