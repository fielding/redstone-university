---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Redstone University">
	<main>
		<section class="hero">
			<div class="hero-inner">
				<img
					src="/assets/project_assets/logo-dark-nobg.png"
					alt="Redstone University crest"
					class="hero-logo"
					width="460"
					height="460"
					fetchpriority="high"
				/>
				<h1 class="hero-title">Build a Computer<br />From Scratch</h1>
				<p class="hero-tagline">
					<span>4 parts</span>
					<span class="tagline-sep" aria-hidden="true">·</span>
					<span>13 modules</span>
					<span class="tagline-sep" aria-hidden="true">·</span>
					<span>0 prerequisites</span>
					<span class="tagline-sep" aria-hidden="true">·</span>
					<span>1 working CPU</span>
				</p>
				<p class="hero-subtitle">
					An interactive course on computer architecture,<br />
					built entirely inside Minecraft.
				</p>
				<nav class="hero-actions">
					<a href="/course/introduction" class="cta-primary">
						Begin the course <span class="cta-arrow" aria-hidden="true">→</span>
					</a>
					<a href="https://github.com/fielding/redstone-university" class="cta-ghost">
						Source on GitHub
					</a>
				</nav>
			</div>
		</section>

		<section class="curriculum">
			<h2 class="section-label scroll-reveal">The Curriculum</h2>
			<ol class="parts-list">
				<li>
					<a href="/course/part-i--foundations/introduction" class="part scroll-reveal">
						<span class="part-numeral">I</span>
						<div class="part-body">
							<h3 class="part-title">The Foundations</h3>
							<p class="part-desc">
								Master Redstone basics, Boolean logic, and build a complete
								input/output system — a 4-bit interface with a working
								7-segment display.
							</p>
							<span class="part-meta">5 modules + 2 interludes</span>
						</div>
					</a>
				</li>
				<li>
					<a href="/course/part-ii-thinking-machine/introduction" class="part scroll-reveal">
						<span class="part-numeral">II</span>
						<div class="part-body">
							<h3 class="part-title">The Thinking Machine</h3>
							<p class="part-desc">
								Build the brain. Design an adder, add subtraction, status
								flags, and a multiplexer — then assemble them into a full
								Arithmetic Logic Unit.
							</p>
							<span class="part-meta">5 modules</span>
						</div>
					</a>
				</li>
				<li>
					<a href="/course/part-iii--processor-core/introduction" class="part scroll-reveal">
						<span class="part-numeral">III</span>
						<div class="part-body">
							<h3 class="part-title">The Processor Core</h3>
							<p class="part-desc">
								Give the machine memory, a clock, and a program counter.
								Define an instruction set and run the first real program on
								hardware you built.
							</p>
							<span class="part-meta">4 modules</span>
						</div>
					</a>
				</li>
				<li>
					<a href="/course/part-iv--post-graduate/introduction" class="part part--advanced scroll-reveal">
						<span class="part-numeral">IV</span>
						<div class="part-body">
							<h3 class="part-title">Post-Graduate Studies</h3>
							<p class="part-desc">
								For those who want more. Implement the Double Dabble algorithm
								to display true decimal output — the hardest challenge in the
								course.
							</p>
							<span class="part-meta">Advanced track</span>
						</div>
					</a>
				</li>
			</ol>
		</section>

		<footer class="closing scroll-reveal">
			<p class="closing-text">No prerequisites. No cost. <em>Just curiosity.</em></p>
			<a href="/course/introduction" class="cta-primary">
				Begin the course <span class="cta-arrow" aria-hidden="true">→</span>
			</a>
		</footer>
	</main>
</Layout>

<style>
	/* ── Hero ── */
	.hero {
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: var(--space-2xl) var(--space-lg);
		position: relative;
		overflow: hidden;
	}

	/* Layered atmospheric glow — breathes like a living torch */
	.hero::before {
		content: '';
		position: absolute;
		inset: -10%;
		background:
			radial-gradient(ellipse 50% 45% at 50% 42%, oklch(18% 0.06 25 / 0.7), transparent),
			radial-gradient(ellipse 90% 70% at 50% 38%, oklch(12% 0.03 25 / 0.5), transparent);
		pointer-events: none;
		animation: breathe 10s ease-in-out infinite;
	}

	/* Secondary glow layer — shifts out of phase for organic feel */
	.hero::after {
		content: '';
		position: absolute;
		inset: -5%;
		background: radial-gradient(ellipse 40% 35% at 50% 36%, oklch(20% 0.08 30 / 0.3), transparent);
		pointer-events: none;
		animation: breathe 7s ease-in-out 3s infinite;
	}

	.hero-inner {
		max-width: 760px;
		text-align: center;
		position: relative;
		z-index: 1;
	}

	.hero-logo {
		width: clamp(280px, 20vw + 180px, 520px);
		height: auto;
		margin-bottom: var(--space-xl);
		filter: drop-shadow(0 0 80px oklch(32% 0.16 25 / 0.6))
		        drop-shadow(0 0 160px oklch(28% 0.10 25 / 0.4));
		animation: reveal-up 1s var(--ease-out) both;
		transition: filter 800ms var(--ease-out-quart);
	}

	/* Torch brightens when you approach — the flame responds */
	.hero-logo:hover {
		filter: drop-shadow(0 0 80px oklch(38% 0.20 25 / 0.7))
		        drop-shadow(0 0 180px oklch(35% 0.14 30 / 0.5));
	}

	.hero-title {
		font-size: clamp(3rem, 5vw + 1rem, 5.5rem);
		line-height: 1.05;
		letter-spacing: -0.02em;
		margin-bottom: var(--space-lg);
		color: oklch(93% 0.003 25);
		animation: reveal-up 900ms var(--ease-out) 150ms both;
	}

	.hero-tagline {
		font-family: var(--font-mono);
		font-size: clamp(0.78rem, 0.6vw + 0.5rem, 0.9rem);
		font-weight: 400;
		letter-spacing: 0.04em;
		color: var(--color-primary-light);
		margin-bottom: var(--space-lg);
		animation: reveal-up 800ms var(--ease-out) 300ms both;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--space-sm) var(--space-md);
	}

	.hero-tagline span {
		white-space: nowrap;
	}

	.tagline-sep {
		color: var(--color-primary-dim);
	}

	.hero-subtitle {
		font-size: clamp(1.05rem, 0.5vw + 0.9rem, 1.25rem);
		font-style: italic;
		color: var(--color-text-secondary);
		line-height: 1.7;
		margin-bottom: var(--space-2xl);
		animation: reveal-up 800ms var(--ease-out) 450ms both;
	}

	.hero-actions {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-md);
		animation: reveal-up 800ms var(--ease-out) 600ms both;
	}

	/* ── CTAs ── */
	.cta-primary {
		font-size: 1rem;
		font-weight: 600;
		letter-spacing: 0.03em;
		color: var(--color-primary-light);
		padding: var(--space-sm) var(--space-xs);
		border-bottom: 1px solid var(--color-primary-dim);
		transition:
			color var(--duration-fast) var(--ease-out),
			border-color var(--duration-fast) var(--ease-out);
	}

	.cta-primary:hover {
		color: var(--color-accent);
		border-color: var(--color-accent);
	}

	/* Arrow slides right on hover — invites you forward */
	.cta-arrow {
		display: inline-block;
		transition: transform 300ms var(--ease-out-quart);
	}

	.cta-primary:hover .cta-arrow {
		transform: translateX(4px);
	}

	.cta-ghost {
		font-size: 0.85rem;
		color: var(--color-text-faint);
		transition: color var(--duration-fast) var(--ease-out);
	}

	.cta-ghost:hover {
		color: var(--color-text-secondary);
	}

	/* ── Curriculum ── */
	.curriculum {
		max-width: 820px;
		margin: 0 auto;
		padding: var(--space-4xl) var(--space-lg) var(--space-3xl);
	}

	.section-label {
		font-family: var(--font-body);
		font-size: 0.75rem;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.15em;
		color: var(--color-text-faint);
		margin-bottom: var(--space-3xl);
	}

	.parts-list {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 0;
	}

	.part {
		display: grid;
		grid-template-columns: 5.5rem 1fr;
		gap: var(--space-xl);
		align-items: baseline;
		text-decoration: none;
		color: inherit;
		padding: var(--space-2xl) var(--space-md);
		margin: 0 calc(-1 * var(--space-md));
		border-top: 1px solid var(--color-border-subtle);
		border-radius: 4px;
		transition: background var(--duration-normal) var(--ease-out-quart);
	}

	.part:hover {
		color: inherit;
		background: oklch(14% 0.005 25 / 0.6);
	}

	.part:hover .part-numeral {
		color: var(--color-accent);
		text-shadow:
			0 0 20px oklch(70% 0.14 70 / 0.4),
			0 0 60px oklch(60% 0.10 50 / 0.2);
	}

	.part:hover .part-body {
		transform: translateX(4px);
	}

	.part:hover .part-title {
		color: oklch(93% 0.003 25);
	}

	.part-numeral {
		font-family: var(--font-display);
		font-size: clamp(3rem, 4vw, 4.5rem);
		line-height: 1;
		color: var(--color-primary-dim);
		transition:
			color 600ms var(--ease-out-quart),
			text-shadow 600ms var(--ease-out-quart);
	}

	/* Numerals ignite to full crimson when scrolled into view */
	.part.in-view .part-numeral {
		color: var(--color-primary);
	}

	.part-body {
		transition: transform var(--duration-normal) var(--ease-out-quart);
	}

	.part-title {
		font-size: clamp(1.4rem, 1.5vw + 0.8rem, 1.85rem);
		margin-bottom: var(--space-sm);
		color: var(--color-text);
		line-height: 1.2;
		transition: color var(--duration-normal) var(--ease-out-quart);
	}

	.part-desc {
		font-size: 0.95rem;
		color: var(--color-text-secondary);
		line-height: 1.75;
		max-width: 52ch;
		margin-bottom: var(--space-sm);
	}

	.part-meta {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--color-text-faint);
		letter-spacing: 0.02em;
	}

	.part--advanced {
		opacity: 0.6;
		transition:
			opacity var(--duration-normal) var(--ease-out-quart),
			background var(--duration-normal) var(--ease-out-quart);
	}

	.part--advanced:hover {
		opacity: 1;
	}

	/* ── Closing ── */
	.closing {
		text-align: center;
		padding: var(--space-4xl) var(--space-lg) var(--space-3xl);
		border-top: 1px solid var(--color-border-subtle);
	}

	.closing-text {
		font-family: var(--font-display);
		font-size: clamp(1.4rem, 2vw + 0.5rem, 2rem);
		color: var(--color-text-secondary);
		margin-bottom: var(--space-xl);
	}

	/* "Just curiosity" — the emotional peak, warmed up */
	.closing-text em {
		font-style: normal;
		color: var(--color-accent);
	}

	/* ── Scroll Reveal ── */
	.scroll-reveal {
		opacity: 0;
		transform: translateY(28px);
	}

	.scroll-reveal.in-view {
		animation: scroll-enter 800ms var(--ease-out) both;
	}

	/* Staggered reveals — delay set via --reveal-delay custom property */
	.scroll-reveal.in-view {
		animation-delay: var(--reveal-delay, 0ms);
	}

	/* ── Animations ── */
	@keyframes reveal-up {
		from {
			opacity: 0;
			transform: translateY(24px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes scroll-enter {
		from {
			opacity: 0;
			transform: translateY(28px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes breathe {
		0%, 100% {
			opacity: 1;
			transform: scale(1);
		}
		50% {
			opacity: 0.7;
			transform: scale(1.03);
		}
	}

	/* ── Reduced motion ── */
	@media (prefers-reduced-motion: reduce) {
		.hero::before,
		.hero::after {
			animation: none;
		}

		.scroll-reveal {
			opacity: 1;
			transform: none;
		}

		.scroll-reveal.in-view {
			animation: none;
		}
	}

	/* ── Responsive ── */
	@media (max-width: 768px) {
		.hero {
			min-height: auto;
			padding: var(--space-3xl) var(--space-md) var(--space-2xl);
		}

		.hero-subtitle br {
			display: none;
		}

		.part {
			grid-template-columns: 3.5rem 1fr;
			gap: var(--space-md);
			padding: var(--space-xl) var(--space-sm);
			margin: 0 calc(-1 * var(--space-sm));
		}

		.curriculum {
			padding: var(--space-3xl) var(--space-md) var(--space-2xl);
		}

		.closing {
			padding: var(--space-3xl) var(--space-md);
		}
	}
</style>

<script is:inline>
	document.addEventListener('DOMContentLoaded', () => {
		// For the curious ones who open devtools
		console.log(
			'%c⚡ Redstone University',
			'font-size: 1.5rem; font-weight: bold; color: #c03020;'
		);
		console.log(
			'%cCurious enough to look under the hood? You\'ll fit right in.\nhttps://github.com/fielding/redstone-university',
			'color: #a08060; font-style: italic;'
		);

		let revealIndex = 0;

		const observer = new IntersectionObserver(
			(entries) => {
				// Sort by position so top elements reveal first
				const visible = entries.filter(e => e.isIntersecting)
					.sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);

				visible.forEach((entry) => {
					entry.target.style.setProperty('--reveal-delay', revealIndex * 100 + 'ms');
					entry.target.classList.add('in-view');
					observer.unobserve(entry.target);
					revealIndex++;
				});

				// Reset stagger index after a batch (new scroll position = new batch)
				if (visible.length) {
					setTimeout(() => { revealIndex = 0; }, 50);
				}
			},
			{ threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
		);

		document.querySelectorAll('.scroll-reveal').forEach((el) => {
			observer.observe(el);
		});
	});
</script>
