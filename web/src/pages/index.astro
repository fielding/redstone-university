---
import Layout from '../layouts/Layout.astro';
import { hasLiveContent, PART_STATUS } from '../utils/gating';

const parts = [
	{
		numeral: 'I',
		dir: 'part-i--foundations',
		title: 'The Foundations',
		desc: 'Master Redstone basics, Boolean logic, and build a complete input/output system, a 4-bit interface with a working 7-segment display.',
		meta: '5 modules + 2 interludes',
		advanced: false,
	},
	{
		numeral: 'II',
		dir: 'part-ii-thinking-machine',
		title: 'The Thinking Machine',
		desc: 'The mathematical and logical brain of the computer. You engineer an adder and subtractor, give it the ability to make decisions with comparators and status flags, and combine everything into a complete Arithmetic Logic Unit.',
		meta: '5 modules',
		advanced: false,
	},
	{
		numeral: 'III',
		dir: 'part-iii--processor-core',
		title: 'The Processor Core',
		desc: 'Give the machine memory, a clock, and a program counter. Define an instruction set and run the first real program on hardware you built.',
		meta: '4 modules',
		advanced: false,
	},
	{
		numeral: 'IV',
		dir: 'part-iv--post-graduate',
		title: 'Post-Graduate Studies',
		desc: 'For those who want more. Implement the Double Dabble algorithm to display true decimal output, the hardest challenge in the course.',
		meta: 'Advanced track',
		advanced: true,
	},
].map((p) => ({ ...p, live: hasLiveContent(p.dir), status: PART_STATUS[p.dir] }));
---

<Layout>
	<noscript>
		<!-- Companion to the @media (scripting: none) rule below, for browsers
		     that do not support that query. -->
		<style is:inline>
			.scroll-reveal {
				opacity: 1 !important;
				transform: none !important;
			}
		</style>
	</noscript>
	<main>
		<section class="hero">
			<div class="hero-inner">
				<img
					src="/assets/project_assets/logo.png"
					alt="Redstone University crest"
					class="hero-logo"
					width="460"
					height="460"
					fetchpriority="high"
				/>
				<h1 class="hero-title">Build a Computer<br />From Scratch</h1>
				<p class="hero-tagline">
					<span>4 parts</span>
					<span>13 modules</span>
					<span>0 prerequisites</span>
					<span>1 working CPU</span>
				</p>
				<p class="hero-subtitle">
					Computer science and digital architecture, built from the ground up in
					Minecraft. Every concept becomes a physical, working machine you can
					walk around inside of.
				</p>
				<nav class="hero-actions">
					<a href="/course/introduction" class="cta-primary">
						Begin the course <span class="cta-arrow" aria-hidden="true">→</span>
					</a>
					<a href="https://github.com/fielding/redstone-university" class="cta-ghost">
						Source on GitHub
					</a>
				</nav>
			</div>
		</section>

		<section class="curriculum">
			<h2 class="section-label scroll-reveal">The Curriculum</h2>
			<ol class="parts-list">
				{parts.map((p) => (
					<li>
						{p.live ? (
							<a
								href={`/course/${p.dir}/introduction`}
								class:list={['part', 'scroll-reveal', { 'part--advanced': p.advanced }]}
							>
								<span class="part-numeral">{p.numeral}</span>
								<div class="part-body">
									<h3 class="part-title">{p.title}{p.status && <span class="part-status">{p.status}</span>}</h3>
									<p class="part-desc">{p.desc}</p>
									<span class="part-meta">{p.meta}</span>
								</div>
							</a>
						) : (
							<div
								class:list={['part', 'part--gated', 'scroll-reveal', { 'part--advanced': p.advanced }]}
							>
								<span class="part-numeral">{p.numeral}</span>
								<div class="part-body">
									<h3 class="part-title">
										{p.title}
										<span class="part-status">{p.status}</span>
									</h3>
									<p class="part-desc">{p.desc}</p>
									<span class="part-meta">{p.meta}</span>
								</div>
							</div>
						)}
					</li>
				))}
			</ol>
			<p class="curriculum-note scroll-reveal">
				The remaining parts are written and their in-world builds are underway.
				Impatient? <a href="https://github.com/fielding/redstone-university">Read ahead on GitHub</a>.
			</p>
		</section>

		<footer class="closing scroll-reveal">
			<p class="closing-text">
				Free, and it stays free. The real push came from my daughter Ada, who
				introduced me to Minecraft before she was even 2. These ideas usually feel
				intangible, but people are out there building machines from Redstone that
				put my old homework to shame. So: what if we learned this by building a
				computer from scratch, with tools we already love?
			</p>
			<a href="/course/introduction" class="cta-primary">
				Begin the course <span class="cta-arrow" aria-hidden="true">→</span>
			</a>
		</footer>
	</main>
</Layout>

<style>
	/* ── Hero ── */
	.hero {
		min-height: min(100vh, 940px);
		display: flex;
		align-items: center;
		justify-content: center;
		padding: var(--space-2xl) var(--space-lg);
		position: relative;
		overflow: hidden;
	}

	/* Layered atmospheric glow that breathes like a living torch */
	.hero::before {
		content: '';
		position: absolute;
		inset: -10%;
		background:
			radial-gradient(ellipse 50% 45% at 50% 42%, oklch(85% 0.08 80 / 0.40), transparent),
			radial-gradient(ellipse 90% 70% at 50% 38%, oklch(90% 0.05 83 / 0.32), transparent);
		pointer-events: none;
		animation: breathe 10s ease-in-out infinite;
	}

	/* Secondary glow layer, shifted out of phase for an organic feel */
	.hero::after {
		content: '';
		position: absolute;
		inset: -5%;
		background: radial-gradient(ellipse 40% 35% at 50% 36%, oklch(82% 0.09 74 / 0.22), transparent);
		pointer-events: none;
		animation: breathe 7s ease-in-out 3s infinite;
	}

	.hero-inner {
		max-width: 880px;
		text-align: center;
		position: relative;
		z-index: 1;
	}

	.hero-logo {
		/* Capped: sized off viewport width, a wide-but-short display used to get
		   a bigger crest and push the CTA below the fold. */
		width: clamp(240px, 16vw + 110px, 320px);
		height: auto;
		margin-bottom: var(--space-xl);
		filter: drop-shadow(0 0 65px oklch(84% 0.10 76 / 0.40))
		        drop-shadow(0 0 150px oklch(87% 0.07 80 / 0.24));
		animation: reveal-up 1s var(--ease-out) both;
		transition: filter 800ms var(--ease-out-quart);
	}

	/* Torch brightens when you approach; the flame responds */
	.hero-logo:hover {
		filter: drop-shadow(0 0 70px oklch(86% 0.09 78 / 0.45))
		        drop-shadow(0 0 170px oklch(86% 0.07 75 / 0.30));
	}

	.hero-title {
		font-size: clamp(3rem, 5vw + 1rem, 5.5rem);
		line-height: 1.05;
		letter-spacing: -0.02em;
		margin-bottom: var(--space-lg);
		color: var(--color-text);
		animation: reveal-up 900ms var(--ease-out) 150ms both;
	}

	.hero-tagline {
		font-family: var(--font-mono);
		font-size: clamp(0.78rem, 0.6vw + 0.5rem, 0.9rem);
		font-weight: 400;
		letter-spacing: 0.04em;
		color: var(--color-primary-light);
		margin-bottom: var(--space-lg);
		animation: reveal-up 800ms var(--ease-out) 300ms both;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--space-sm) var(--space-md);
	}

	.hero-tagline span {
		white-space: nowrap;
	}

	/* Separator belongs to the item that follows it, so a wrap never strands a
	   lone middot at the end of a line. */
	.hero-tagline span + span::before {
		content: '·';
		color: var(--color-primary-dim);
		margin-right: var(--space-md);
	}

	.hero-subtitle {
		font-size: clamp(1.05rem, 0.5vw + 0.9rem, 1.25rem);
		font-style: italic;
		color: var(--color-text-secondary);
		line-height: 1.7;
		/* Wide enough to hold both sentences in two lines at 1440px, which is
		   what keeps the primary CTA above the fold. */
		max-width: 68ch;
		margin: 0 auto var(--space-2xl);
		text-wrap: balance;
		animation: reveal-up 800ms var(--ease-out) 450ms both;
	}

	.hero-actions {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-md);
		animation: reveal-up 800ms var(--ease-out) 600ms both;
	}

	/* ── CTAs ── */
	.cta-primary {
		font-size: 1rem;
		font-weight: 600;
		letter-spacing: 0.03em;
		color: var(--color-primary-light);
		padding: var(--space-sm) var(--space-xs);
		border-bottom: 1px solid var(--color-primary-dim);
		transition:
			color var(--duration-fast) var(--ease-out),
			border-color var(--duration-fast) var(--ease-out);
	}

	.cta-primary:hover {
		color: var(--color-accent);
		border-color: var(--color-accent);
	}

	/* Arrow slides right on hover, inviting you forward */
	.cta-arrow {
		display: inline-block;
		transition: transform 300ms var(--ease-out-quart);
	}

	.cta-primary:hover .cta-arrow {
		transform: translateX(4px);
	}

	.cta-ghost {
		font-size: 0.85rem;
		color: var(--color-text-faint);
		transition: color var(--duration-fast) var(--ease-out);
	}

	.cta-ghost:hover {
		color: var(--color-text-secondary);
	}

	/* ── Curriculum ── */
	.curriculum {
		max-width: 820px;
		margin: 0 auto;
		padding: var(--space-4xl) var(--space-lg) var(--space-3xl);
	}

	/* Eyebrow label; shares the sans role with .toc-label and .nav-section */
	.section-label {
		font-family: var(--font-reading);
		font-size: 0.75rem;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.15em;
		color: var(--color-text-faint);
		margin-bottom: var(--space-3xl);
	}

	.parts-list {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 0;
	}

	.part {
		display: grid;
		grid-template-columns: 5.5rem 1fr;
		gap: var(--space-xl);
		align-items: start;
		text-decoration: none;
		color: inherit;
		padding: var(--space-2xl) var(--space-md);
		margin: 0 calc(-1 * var(--space-md));
		border-top: 1px solid var(--color-border-subtle);
		border-radius: 4px;
		transition: background var(--duration-normal) var(--ease-out-quart);
	}

	.part:hover {
		color: inherit;
		background: var(--color-panel);
	}

	.part:hover .part-numeral {
		color: var(--color-accent);
		text-shadow:
			0 0 20px oklch(70% 0.14 70 / 0.4),
			0 0 60px oklch(60% 0.10 50 / 0.2);
	}

	.part:hover .part-body {
		transform: translateX(4px);
	}

	.part:hover .part-title {
		color: var(--color-text);
	}

	.part-numeral {
		font-family: var(--font-display);
		font-size: clamp(3rem, 4vw, 4.5rem);
		line-height: 1;
		text-align: right;
		color: var(--color-primary-dim);
		transition:
			color 600ms var(--ease-out-quart),
			text-shadow 600ms var(--ease-out-quart);
	}

	/* Numerals ignite to full crimson when scrolled into view */
	.part.in-view .part-numeral {
		color: var(--color-primary);
	}

	.part-body {
		transition: transform var(--duration-normal) var(--ease-out-quart);
	}

	.part-title {
		font-size: clamp(1.4rem, 1.5vw + 0.8rem, 1.85rem);
		margin-bottom: var(--space-sm);
		color: var(--color-text);
		line-height: 1.2;
		transition: color var(--duration-normal) var(--ease-out-quart);
	}

	.part-desc {
		font-size: 0.95rem;
		color: var(--color-text-secondary);
		line-height: 1.75;
		max-width: 52ch;
		margin-bottom: var(--space-sm);
	}

	.part-meta {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--color-text-faint);
		letter-spacing: 0.02em;
	}

	/* Quieter than the main sequence. Dimmed with colour rather than opacity:
	   opacity multiplies against text colours already picked for contrast. */
	.part--advanced .part-title,
	.part--gated .part-title {
		color: var(--color-text-secondary);
	}

	.part--advanced .part-desc,
	.part--gated .part-desc {
		color: var(--color-text-faint);
	}

	.part--advanced {
		transition: background var(--duration-normal) var(--ease-out-quart);
	}

	.part--advanced:hover .part-title {
		color: var(--color-text);
	}

	.part--advanced:hover .part-desc {
		color: var(--color-text-secondary);
	}

	/* ── Gated parts (in build): visible roadmap, clearly not clickable ── */
	.part--gated {
		cursor: default;
	}

	.part--gated:hover {
		background: none;
	}

	.part--gated:hover .part-body {
		transform: none;
	}

	.part--gated:hover .part-numeral {
		color: var(--color-primary-dim);
		text-shadow: none;
	}

	.part--gated.in-view .part-numeral {
		color: var(--color-primary-dim);
	}

	.part-status {
		font-family: var(--font-mono);
		font-size: 0.62rem;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-faint);
		border: 1px solid var(--color-border-subtle);
		border-radius: 999px;
		padding: 2px 9px;
		margin-left: var(--space-md);
		vertical-align: middle;
		white-space: nowrap;
	}

	.curriculum-note {
		margin-top: var(--space-2xl);
		padding-top: var(--space-lg);
		border-top: 1px solid var(--color-border-subtle);
		font-size: 0.85rem;
		color: var(--color-text-faint);
	}

	.curriculum-note a {
		color: var(--color-text-secondary);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.curriculum-note a:hover {
		color: var(--color-primary-light);
	}

	/* ── Closing ── */
	.closing {
		text-align: center;
		padding: var(--space-4xl) var(--space-lg) var(--space-3xl);
		border-top: 1px solid var(--color-border-subtle);
	}

	.closing-text {
		font-size: clamp(1.05rem, 0.4vw + 0.95rem, 1.2rem);
		line-height: 1.75;
		color: var(--color-text-secondary);
		max-width: 58ch;
		margin: 0 auto var(--space-xl);
		text-align: left;
	}

	/* ── Scroll Reveal ── */
	.scroll-reveal {
		opacity: 0;
		transform: translateY(28px);
	}

	.scroll-reveal.in-view {
		animation: scroll-enter 800ms var(--ease-out) both;
	}

	/* Staggered reveals; delay set via the --reveal-delay custom property */
	.scroll-reveal.in-view {
		animation-delay: var(--reveal-delay, 0ms);
	}

	/* ── Animations ── */
	@keyframes reveal-up {
		from {
			opacity: 0;
			transform: translateY(24px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes scroll-enter {
		from {
			opacity: 0;
			transform: translateY(28px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes breathe {
		0%, 100% {
			opacity: 1;
			transform: scale(1);
		}
		50% {
			opacity: 0.7;
			transform: scale(1.03);
		}
	}

	/* ── No JavaScript ── */
	/* .in-view is only ever added by an IntersectionObserver, so without a
	   script every revealed element would stay at opacity 0. */
	@media (scripting: none) {
		.scroll-reveal {
			opacity: 1;
			transform: none;
		}
	}

	/* ── Reduced motion ── */
	@media (prefers-reduced-motion: reduce) {
		.hero::before,
		.hero::after {
			animation: none;
		}

		.scroll-reveal {
			opacity: 1;
			transform: none;
		}

		.scroll-reveal.in-view {
			animation: none;
		}
	}

	/* ── Responsive ── */
	/* Narrow screens cannot hold the four stats on one line. A 2x2 grid drops
	   the separators and the orphaned fourth item along with them. */
	@media (max-width: 560px) {
		.hero-tagline {
			display: grid;
			grid-template-columns: repeat(2, auto);
			justify-content: center;
			justify-items: center;
			gap: var(--space-xs) var(--space-lg);
		}

		.hero-tagline span + span::before {
			content: none;
		}
	}

	@media (max-width: 768px) {
		.hero {
			min-height: auto;
			padding: var(--space-3xl) var(--space-md) var(--space-2xl);
		}

		.part {
			grid-template-columns: 3.5rem 1fr;
			gap: var(--space-md);
			padding: var(--space-xl) var(--space-sm);
			margin: 0 calc(-1 * var(--space-sm));
		}

		.curriculum {
			padding: var(--space-3xl) var(--space-md) var(--space-2xl);
		}

		.closing {
			padding: var(--space-3xl) var(--space-md);
		}
	}
</style>

<script is:inline>
	document.addEventListener('DOMContentLoaded', () => {
		// For the curious ones who open devtools
		console.log(
			'%c⚡ Redstone University',
			'font-size: 1.5rem; font-weight: bold; color: #c03020;'
		);
		console.log(
			'%cCurious enough to look under the hood? You\'ll fit right in.\nhttps://github.com/fielding/redstone-university',
			'color: #a08060; font-style: italic;'
		);

		let revealIndex = 0;

		const observer = new IntersectionObserver(
			(entries) => {
				// Sort by position so top elements reveal first
				const visible = entries.filter(e => e.isIntersecting)
					.sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);

				visible.forEach((entry) => {
					entry.target.style.setProperty('--reveal-delay', revealIndex * 100 + 'ms');
					entry.target.classList.add('in-view');
					observer.unobserve(entry.target);
					revealIndex++;
				});

				// Reset stagger index after a batch (new scroll position = new batch)
				if (visible.length) {
					setTimeout(() => { revealIndex = 0; }, 50);
				}
			},
			{ threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
		);

		document.querySelectorAll('.scroll-reveal').forEach((el) => {
			observer.observe(el);
		});
	});
</script>
