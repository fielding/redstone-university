---
import type { CourseNode } from '../utils/navigation';

interface Props {
  node: CourseNode;
  depth?: number;
  currentSlug?: string;
}

const { node, depth = 0, currentSlug } = Astro.props;
const hasChildren = node.children.length > 0;
const isCurrent = node.slug === currentSlug;
---

<li class="nav-item" style={`--depth: ${depth}`}>
  {node.slug ? (
    <a
      href={`/course/${node.slug}`}
      class:list={['nav-link', { 'is-active': isCurrent }]}
      aria-current={isCurrent ? 'page' : undefined}
    >
      {node.title}
    </a>
  ) : node.gated && hasChildren ? (
    <span class="nav-section nav-section--gated">
      {node.title}
      <span class="nav-badge">{node.status ?? 'in build'}</span>
    </span>
  ) : node.gated ? (
    <span class="nav-link is-gated">{node.title}</span>
  ) : (
    <span class="nav-section">{node.title}</span>
  )}

  {hasChildren && (
    <ul class="nav-children">
      {node.children.map((child) => (
        <Astro.self node={child} depth={depth + 1} currentSlug={currentSlug} />
      ))}
    </ul>
  )}
</li>

<style>
  .nav-item {
    list-style: none;
  }

  .nav-link {
    display: block;
    padding: 6px 0;
    padding-left: calc(var(--depth, 0) * var(--space-md));
    color: var(--color-text-faint);
    font-size: 0.88rem;
    line-height: 1.5;
    text-decoration: none;
    transition: color 150ms var(--ease-out);
  }

  .nav-link:hover {
    color: var(--color-text);
  }

  .nav-link.is-active {
    color: var(--color-primary-light);
    font-weight: 500;
  }

  /* Unpublished module titles: visible roadmap, clearly not clickable */
  .nav-link.is-gated {
    color: var(--color-text-faint);
    opacity: 0.55;
    cursor: default;
  }

  .nav-section--gated {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
  }

  .nav-badge {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-faint);
    border: 1px solid var(--color-border-subtle);
    border-radius: 999px;
    padding: 1px 7px;
    white-space: nowrap;
  }

  .nav-section {
    display: block;
    padding-top: var(--space-lg);
    padding-bottom: var(--space-xs);
    padding-left: calc(var(--depth, 0) * var(--space-md));
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-secondary);
  }

  .nav-item:first-child > .nav-section {
    padding-top: 0;
  }

  .nav-children {
    padding: 0;
    margin: 0;
  }
</style>
