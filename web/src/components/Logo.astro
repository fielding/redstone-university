---
interface Props {
  width?: string;
  height?: string;
  className?: string;
}

const { width = "auto", height = "auto", className = "" } = Astro.props;
---

<img
  src="/assets/project_assets/logo-dark-nobg.png"
  alt="Redstone University Logo"
  class:list={['logo-img', className]}
  style={`width: ${width}; height: ${height}; max-width: 100%; object-fit: contain;`}
/>

<style>
  .logo-img {
    animation: logo-fade 400ms var(--ease-out) both;
  }

  @keyframes logo-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-img { animation: none; }
  }
</style>
