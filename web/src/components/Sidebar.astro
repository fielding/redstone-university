---
import { getCollection } from 'astro:content';
import { buildCourseHierarchy } from '../utils/navigation';
import { applyGating } from '../utils/gating';
import SidebarItem from './SidebarItem.astro';

interface Props {
  currentSlug?: string;
}

const { currentSlug } = Astro.props;
const courseEntries = await getCollection('course');
const navigationTree = applyGating(buildCourseHierarchy(courseEntries));
const anyGated = navigationTree.some((node) => node.gated);
---

<nav class="sidebar-nav" aria-label="Course navigation">
  <ul class="nav-root">
    {navigationTree.map((node) => (
      <SidebarItem node={node} currentSlug={currentSlug} />
    ))}
  </ul>
  {anyGated && (
    <p class="nav-footnote">
      The remaining parts are drafted and their in-world builds are underway.
      Impatient? <a href="https://github.com/fielding/redstone-university">Read ahead on GitHub</a>.
    </p>
  )}
</nav>

<style>
  .sidebar-nav {
    flex: 1;
    min-height: 0; /* allow the scroll area to shrink inside a flex column */
    overflow-y: auto;
    padding: var(--space-xs) 0;
  }

  .nav-root {
    padding: 0;
    margin: 0;
  }

  .nav-footnote {
    margin: var(--space-lg) 0 0;
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border-subtle);
    font-size: 0.72rem;
    line-height: 1.6;
    color: var(--color-text-faint);
  }

  .nav-footnote a {
    color: var(--color-text-secondary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .nav-footnote a:hover {
    color: var(--color-primary-light);
  }

  .sidebar-nav::-webkit-scrollbar {
    width: 4px;
  }

  .sidebar-nav::-webkit-scrollbar-track {
    background: transparent;
  }

  .sidebar-nav::-webkit-scrollbar-thumb {
    background: var(--color-border);
    border-radius: 2px;
  }
</style>
