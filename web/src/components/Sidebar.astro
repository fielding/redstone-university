---
import { getCollection } from 'astro:content';
import { buildCourseHierarchy } from '../utils/navigation';
import SidebarItem from './SidebarItem.astro';

const courseEntries = await getCollection('course');
const navigationTree = buildCourseHierarchy(courseEntries);
---

<nav class="sidebar-nav">
  <ul class="root-list">
    {navigationTree.map((node) => (
      <SidebarItem node={node} />
    ))}
  </ul>
</nav>

<style>
  .sidebar-nav {
    height: 100%;
    overflow-y: auto;
    padding-right: 0.5rem;
  }

  .root-list {
    padding: 0;
    margin: 0;
  }

  /* Custom Scrollbar */
  .sidebar-nav::-webkit-scrollbar {
    width: 6px;
  }

  .sidebar-nav::-webkit-scrollbar-track {
    background: transparent;
  }

  .sidebar-nav::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 3px;
  }

  .sidebar-nav::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.2);
  }
</style>
